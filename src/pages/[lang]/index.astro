---
import { getCollection } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import Grid from '../../components/Grid.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import PortfolioPreview from '../../components/PortfolioPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const translatePath = useTranslatedPath(lang as keyof typeof languages);

// Content Fetching: List all work projects, sorted by order (if present)
const projects = (await getCollection('work'))
	.filter((entry) => entry.id.startsWith(`${lang}/`))
	.sort((a, b) => (b.data.order || 0) - (a.data.order || 0));

// Extract unique tags for filtering
const allTags = Array.from(new Set(projects.flatMap((project) => project.data.tags || [])));
---

<BaseLayout title={t('home.hero.title')} description={t('home.hero.tagline')}>
	<div class="stack gap-10 lg:gap-24">
		<div class="wrapper stack gap-8 lg:gap-10">
			<header class="hero">
				<Hero
					title={t('home.hero.title')}
					tagline={t('home.hero.tagline')}
					align="start"
				>
					<div class="roles">
						<Pill>{t('home.hero.roles.unreal')}</Pill>
						<Pill>{t('home.hero.roles.unity')}</Pill>
						<Pill>{t('home.hero.roles.custom')}</Pill>
					</div>
					<div class="cv-container">
						<a class="cv-link" href={lang === 'en' ? '/assets/CV_Lilian_Cartellier_Gameplay_Programmer.pdf' : '/assets/CV_Lilian_Cartellier_Programmeur_Gameplay.pdf'} download>
							<Icon icon="file-text" size="1.2em" />
							{t('home.hero.cv')}
						</a>
					</div>
				</Hero>

				<img
					alt="Lilian Cartellier - Gameplay Programmer"
					width="480"
					height="620"
					src="/assets/portrait.jpg"
				/>
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section id="work" class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>{t('home.work.header.title')}</h3>
					<p>{t('home.work.header.subtitle')}</p>
				</header>

				<!-- Tag Filters -->
				<div class="filters-container">
					<button class="filter-btn active" data-filter="all">{t('projects.filter.all')}</button>
					{allTags.map((tag) => (
						<button class="filter-btn" data-filter={tag}>{tag}</button>
					))}
				</div>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li data-tags={JSON.stringify(project.data.tags || [])}>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const filterButtons = document.querySelectorAll('.filter-btn');
		const projectItems = document.querySelectorAll('.gallery li');

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				// Update active button state
				filterButtons.forEach((btn) => btn.classList.remove('active'));
				button.classList.add('active');

				const filter = button.getAttribute('data-filter');

				projectItems.forEach((item) => {
					const tagsAttr = item.getAttribute('data-tags');
					if (!tagsAttr) return;
					const tags = JSON.parse(tagsAttr);

					if (filter === 'all' || tags.includes(filter)) {
						(item as HTMLElement).style.display = '';
					} else {
						(item as HTMLElement).style.display = 'none';
					}
				});
			});
		});
	});
</script>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	.cv-container {
		margin-top: 1rem;
	}

	.cv-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border: 1px solid var(--accent-regular);
		border-radius: 999rem;
		color: var(--accent-regular);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		text-decoration: none;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
		transition: background var(--theme-transition), color var(--theme-transition), border-color var(--theme-transition);
	}

	.cv-link:hover {
		background: var(--accent-regular);
		color: var(--gray-999);
		border-color: var(--accent-regular);
	}

	/* Filters Styling */
	.filters-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		grid-area: header; /* or placed appropriately */
		margin-bottom: 1rem;
	}

	.filter-btn {
		padding: 0.5rem 1.25rem;
		border-radius: 999rem;
		border: 1px solid var(--gray-800);
		background: var(--gray-900);
		color: var(--gray-300);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		cursor: pointer;
		transition: all var(--theme-transition);
	}

	.filter-btn:hover {
		border-color: var(--accent-regular);
		color: var(--gray-100);
	}

	.filter-btn.active {
		background: var(--accent-regular);
		color: var(--gray-999);
		border-color: var(--accent-regular);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}

		.filters-container {
			justify-content: flex-start;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: -5rem;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'filters filters filters filters' 'gallery gallery gallery gallery';
			gap: 3rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'filters filters filters filters' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			grid-area: header;
			font-size: var(--text-4xl);
		}

		.filters-container {
			grid-area: filters;
			margin-top: -1rem;
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}
</style>
